diff -urN a/templates/register-job.yaml b/templates/register-job.yaml
--- a/templates/register-job.yaml	2026-09-16 15:06:40
+++ b/templates/register-job.yaml	2026-09-16 15:06:41
@@ -52,12 +52,12 @@
             - name: AKUITY_API_KEY_ID
               valueFrom:
                 secretKeyRef:
-                  name: akuity-agent-credentials
-                  key: AKUITY_API_KEY_ID
+                  name: {{ .Values.existingSecret.name | default "akuity-agent-credentials" }}
+                  key: {{ .Values.existingSecret.keyIdKey | default "AKUITY_API_KEY_ID" }}
             - name: AKUITY_API_KEY_SECRET
               valueFrom:
                 secretKeyRef:
-                  name: akuity-agent-credentials
-                  key: AKUITY_API_KEY_SECRET
+                  name: {{ .Values.existingSecret.name | default "akuity-agent-credentials" }}
+                  key: {{ .Values.existingSecret.keySecretKey | default "AKUITY_API_KEY_SECRET" }}
             - name: AKUITY_SERVER_URL
               value: {{ .Values.akuityServerUrl | quote }}
diff -urN a/templates/secret.yaml b/templates/secret.yaml
--- a/templates/secret.yaml	2026-09-16 15:06:40
+++ b/templates/secret.yaml	2026-09-16 15:06:41
@@ -1,3 +1,4 @@
+{{- if not .Values.existingSecret.name }}
 apiVersion: v1
 kind: Secret
 metadata:
@@ -12,3 +13,4 @@
 stringData:
   AKUITY_API_KEY_ID: {{ required "akuityApiKeyId is required" .Values.akuityApiKeyId | quote }}
   AKUITY_API_KEY_SECRET: {{ required "akuityApiKeySecret is required" .Values.akuityApiKeySecret | quote }}
+{{- end }}
diff -urN a/values.yaml b/values.yaml
--- a/values.yaml	2026-09-16 15:06:40
+++ b/values.yaml	2026-09-16 15:06:41
@@ -17,6 +17,19 @@
 # -- Akuity API key secret (required)
 akuityApiKeySecret: ""
 
+# -- Use a pre-existing Secret for the Akuity API credentials instead of having
+#    the chart render one from akuityApiKeyId/akuityApiKeySecret. When set, no
+#    Secret is created by this chart and the two values above are not required.
+#    The Secret must exist in the release namespace; the register Job will wait
+#    for it if it is not there yet.
+existingSecret:
+  # -- Name of the pre-existing Secret. Empty means the chart renders its own.
+  name: ""
+  # -- Key within that Secret holding the Akuity API key ID
+  keyIdKey: AKUITY_API_KEY_ID
+  # -- Key within that Secret holding the Akuity API key secret
+  keySecretKey: AKUITY_API_KEY_SECRET
+
 # -- Akuity server URL
 akuityServerUrl: "https://akuity.cloud"
 

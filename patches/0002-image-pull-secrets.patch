       containers:
         - name: register
           image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
diff -urN work/base/values.yaml work/c/values.yaml
--- a/values.yaml	2026-09-28 09:51:26
+++ b/values.yaml	2026-09-28 09:51:50
@@ -123,3 +123,12 @@
   repository: quay.io/akuity/akuity-cli
   tag: latest
   pullPolicy: IfNotPresent
+
+# -- Image pull secrets for the register Job. The Secrets must already exist in
+#    the release namespace (kubernetes.io/dockerconfigjson). Needed when the
+#    register image is served from a registry that requires authentication, e.g.
+#    a mirror in an environment where quay.io is not reachable or not allowed.
+#    e.g.:
+#    imagePullSecrets:

 kind: ClusterRole
diff -urN work/base/templates/register-job.yaml work/c/templates/register-job.yaml
--- a/templates/register-job.yaml	2026-09-28 09:51:26
+++ b/templates/register-job.yaml	2026-09-28 09:51:50
@@ -16,6 +16,10 @@
     spec:
       restartPolicy: Never
       serviceAccountName: akuity-agent-register
+      {{- with .Values.imagePullSecrets }}
